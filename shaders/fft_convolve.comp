#version 450
#extension GL_GOOGLE_include_directive : require

// FFT convolution: the neighborhood U = K * A of lenia_neighborhood (toroidal wrap, same
// orientation) as a product of spectra, for power-of-two grids. Mirrors lenia::convolve_fft
// (src/fft_convolve.cpp) step for step; see include/lenia/fft_convolve.hpp.
//
// One workgroup transforms one line (a pair of rows, or one column of the half spectrum) in
// shared memory with radix-2 butterflies: forward transforms by decimation in frequency
// (natural order in, bit-reversed out), inverse ones by decimation in time (bit-reversed in,
// natural out), so the column spectra and khat stay in bit-reversed order and no pass reorders.
// The input is real, so rows 2j and 2j + 1 share one complex transform and only the half
// spectrum, columns 0 .. width / 2, is kept: spec and khat hold (width / 2 + 1) * height values.
//
// Passes (p.pass, lenia::FftPass), each its own dispatch:
//   0 RowsForward        src rows          -> spec    (height / 2 workgroups)
//   1 KernelRowsForward  ker, folded       -> spec    (height / 2)
//   2 KernelColumns      spec columns      -> khat / (width * height)   (width / 2 + 1)
//   3 ConvolveColumns    spec * khat       -> spec    (width / 2 + 1)
//   4 RowsInverse        spec -> U; dst = U, or with p.fuse the next state (height / 2)

layout(local_size_x_id = 1) in;                // threads per line, a power of two
layout(constant_id = 0) const uint FFT_MAX = 2048; // longest line; fits shared memory

layout(std430, set = 0, binding = 0) readonly buffer Src { float src[]; };
layout(std430, set = 0, binding = 1) readonly buffer Ker { float ker[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Dst { float dst[]; };
layout(std430, set = 0, binding = 3) buffer Spec { vec2 spec[]; };
layout(std430, set = 0, binding = 4) buffer KHat { vec2 khat[]; };
layout(std430, set = 0, binding = 5) readonly buffer Twiddles { vec2 tw[]; }; // exp(-2 pi i t / 2^log2_tw)

layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint log2w;
    uint log2h;
    uint log2_tw;
    uint kwidth;
    uint kheight;
    uint pass;
    uint fuse;
    float mu;
    float sigma;
    float dt;
    uint growth; // lenia::GrowthFunction
} p;

#include "lenia_math.glsl"

shared vec2 buf[FFT_MAX];

vec2 cmul(vec2 a, vec2 b) { return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x); }

uint bitrev(uint i, uint bits) { return bitfieldReverse(i) >> (32u - bits); }

void sync() {
    memoryBarrierShared();
    barrier();
}

// Forward, natural order in, bit-reversed out. Starts and ends synchronized.
void fft_dif(uint n_log2) {
    const uint half_n = 1u << (n_log2 - 1u);
    for (uint s = n_log2; s >= 1u; --s) {
        const uint h = 1u << (s - 1u);
        for (uint b = gl_LocalInvocationID.x; b < half_n; b += gl_WorkGroupSize.x) {
            const uint pos = b & (h - 1u);
            const uint i0 = ((b >> (s - 1u)) << s) + pos;
            const uint i1 = i0 + h;
            const vec2 u = buf[i0];
            const vec2 v = buf[i1];
            buf[i0] = u + v;
            buf[i1] = cmul(u - v, tw[pos << (p.log2_tw - s)]);
        }
        sync();
    }
}

// Inverse, unnormalized, bit-reversed order in, natural out. Starts and ends synchronized.
void ifft_dit(uint n_log2) {
    const uint half_n = 1u << (n_log2 - 1u);
    for (uint s = 1u; s <= n_log2; ++s) {
        const uint h = 1u << (s - 1u);
        for (uint b = gl_LocalInvocationID.x; b < half_n; b += gl_WorkGroupSize.x) {
            const uint pos = b & (h - 1u);
            const uint i0 = ((b >> (s - 1u)) << s) + pos;
            const uint i1 = i0 + h;
            vec2 w = tw[pos << (p.log2_tw - s)];
            w.y = -w.y;
            const vec2 u = buf[i0];
            const vec2 v = cmul(buf[i1], w);
            buf[i0] = u + v;
            buf[i1] = u - v;
        }
        sync();
    }
}

// Sum of the kernel taps landing on torus cell (x, y): tap (kx, ky) is offset (kx - cx, ky - cy)
// as in lenia_neighborhood; kernels larger than the grid land on a cell more than once.
float kernel_folded(uint x, uint y) {
    float sum = 0.0;
    for (uint ky = (y + p.kheight / 2u) % p.height; ky < p.kheight; ky += p.height) {
        for (uint kx = (x + p.kwidth / 2u) % p.width; kx < p.kwidth; kx += p.width) sum += ker[ky * p.kwidth + kx];
    }
    return sum;
}

void rows_forward(bool from_kernel) {
    const uint W = p.width;
    const uint wh = W / 2u + 1u;
    const uint y0 = 2u * gl_WorkGroupID.x;
    const uint y1 = y0 + 1u;
    for (uint x = gl_LocalInvocationID.x; x < W; x += gl_WorkGroupSize.x) {
        buf[x] = from_kernel ? vec2(kernel_folded(x, y0), kernel_folded(x, y1))
                             : vec2(src[y0 * W + x], src[y1 * W + x]);
    }
    sync();
    fft_dif(p.log2w);
    // A(k) = (Z(k) + conj Z(-k)) / 2 is row y0's spectrum, B(k) = (Z(k) - conj Z(-k)) / 2i row y1's.
    for (uint k = gl_LocalInvocationID.x; k < wh; k += gl_WorkGroupSize.x) {
        const vec2 zk = buf[bitrev(k, p.log2w)];
        vec2 zm = buf[bitrev((W - k) & (W - 1u), p.log2w)];
        zm.y = -zm.y;
        const vec2 d = zk - zm;
        spec[y0 * wh + k] = 0.5 * (zk + zm);
        spec[y1 * wh + k] = 0.5 * vec2(d.y, -d.x);
    }
}

void columns(bool kernel_pass) {
    const uint H = p.height;
    const uint wh = p.width / 2u + 1u;
    const uint k = gl_WorkGroupID.x;
    for (uint y = gl_LocalInvocationID.x; y < H; y += gl_WorkGroupSize.x) buf[y] = spec[y * wh + k];
    sync();
    fft_dif(p.log2h); // buf[i] is the column's spectrum at bitrev(i)
    if (kernel_pass) {
        const float scale = 1.0 / (float(p.width) * float(H));
        for (uint i = gl_LocalInvocationID.x; i < H; i += gl_WorkGroupSize.x) khat[k * H + i] = scale * buf[i];
    } else {
        for (uint i = gl_LocalInvocationID.x; i < H; i += gl_WorkGroupSize.x) buf[i] = cmul(buf[i], khat[k * H + i]);
        sync();
        ifft_dit(p.log2h);
        for (uint y = gl_LocalInvocationID.x; y < H; y += gl_WorkGroupSize.x) spec[y * wh + k] = buf[y];
    }
}

void store(uint i, float u) {
    if (p.fuse != 0u) {
        dst[i] = lenia_next(src[i], lenia_growth(u, p.mu, p.sigma, p.growth), p.dt);
    } else {
        dst[i] = u;
    }
}

void rows_inverse() {
    const uint W = p.width;
    const uint wh = W / 2u + 1u;
    const uint y0 = 2u * gl_WorkGroupID.x;
    const uint y1 = y0 + 1u;
    // Z(k) = P(k) + i Q(k) with P, Q the two rows' spectra; conj P(W - k) for k > W / 2.
    for (uint k = gl_LocalInvocationID.x; k < W; k += gl_WorkGroupSize.x) {
        vec2 z;
        if (k <= W / 2u) {
            const vec2 P = spec[y0 * wh + k];
            const vec2 Q = spec[y1 * wh + k];
            z = vec2(P.x - Q.y, P.y + Q.x);
        } else {
            const vec2 P = spec[y0 * wh + (W - k)];
            const vec2 Q = spec[y1 * wh + (W - k)];
            z = vec2(P.x + Q.y, Q.x - P.y);
        }
        buf[bitrev(k, p.log2w)] = z;
    }
    sync();
    ifft_dit(p.log2w);
    for (uint x = gl_LocalInvocationID.x; x < W; x += gl_WorkGroupSize.x) {
        const vec2 u = buf[x];
        store(y0 * W + x, u.x);
        store(y1 * W + x, u.y);
    }
}

void main() {
    if (p.pass == 0u) {
        rows_forward(false);
    } else if (p.pass == 1u) {
        rows_forward(true);
    } else if (p.pass == 2u) {
        columns(true);
    } else if (p.pass == 3u) {
        columns(false);
    } else {
        rows_inverse();
    }
}
