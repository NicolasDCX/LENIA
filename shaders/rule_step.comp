#version 450
#extension GL_GOOGLE_include_directive : require

// One generation of a node-graph cell rule per dispatch (lenia::VulkanStepper::step_rule):
// the same interpreter as the workbench (lenia_rule.glsl), mirroring lenia::step_rule.
//
// With planes == 2 the buffers hold the density (width * height floats) followed by the
// nutrient (as many again), and both are updated from the current state together; with
// planes == 1 only the density, and the rule sees a nutrient of 0. `ker` holds the active kernel
// followed by the rule's Convolve kernels (lenia::pack_rule_kernels).

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer Src { float src[]; };
layout(std430, set = 0, binding = 1) readonly buffer Ker { float ker[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Dst { float dst[]; };

layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint kwidth;
    uint kheight;
    uint planes;
} p;

#include "lenia_math.glsl"

#define LENIA_RULE_BINDING 3
#include "lenia_rule.glsl"

void main() {
    const uint x = gl_GlobalInvocationID.x;
    const uint y = gl_GlobalInvocationID.y;
    if (x >= p.width || y >= p.height) return;

    const uint i = y * p.width + x;
    const uint plane = p.width * p.height;
    const float u = lenia_neighborhood(x, y, p.width, p.height, p.kwidth, p.kheight);
    const float n = p.planes > 1u ? src[plane + i] : 0.0;
    float g;
    float next_n;
    float unused;
    dst[i] = lenia_rule(x, y, p.width, p.height, p.planes, src[i], n, u, LENIA_NO_REGISTER, g, next_n, unused);
    if (p.planes > 1u) dst[plane + i] = next_n;
}
